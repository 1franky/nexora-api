# /etc/nexora/respaldo.env (dueño root, legible solo por el usuario del servicio: chmod 640, grupo francisco).
# Nunca se versiona. Ver ops/respaldos/README.md.

# Bucket privado de Cloudflare R2 (S3), SOLO para Nexora (no el de Velora). <cuenta> es el ID de tu cuenta de Cloudflare.
RESTIC_REPOSITORY=s3:https://<cuenta>.r2.cloudflarestorage.com/nexora-respaldos
# Token de R2 con permiso de lectura y escritura SOLO en ese bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Contraseña de cifrado de restic, en su propio archivo (chmod 640, grupo francisco), distinta de la de Velora.
# Sin ella NO se puede restaurar: guarda una copia en tu gestor de contraseñas.
RESTIC_PASSWORD_FILE=/etc/nexora/restic-password

# Alertas: un fallo abre un issue en este repositorio. Token fine-grained con permiso "Issues: Read and write" solo
# en 1franky/nexora-api.
NEXORA_ALERT_REPO=1franky/nexora-api
NEXORA_ALERT_TOKEN=

# Tope de tamaño del repositorio en R2, en GB (10^9 bytes). Al pasar el NEXORA_WARN_REPO_PCT % y el 100 % se abre un
# issue, uno por nivel mientras siga abierto. El respaldo NO se detiene ni se borra nada. Sin NEXORA_MAX_REPO_GB, no hay tope.
NEXORA_MAX_REPO_GB=1
NEXORA_WARN_REPO_PCT=80

# Opcionales (valores por omisión del despliegue):
# NEXORA_PG_CONTAINER=nexora-postgres
# NEXORA_DB_NAME=nexora
# NEXORA_DB_USERNAME=nexora
# NEXORA_KEEP_DAILY=7
# NEXORA_KEEP_WEEKLY=4
# NEXORA_KEEP_MONTHLY=6

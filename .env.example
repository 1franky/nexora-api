# Variables para compose.yaml. Copiar a .env y ajustar; .env nunca debe
# subirse al repositorio (usa valores fuertes en el VPS, no los de dev).

# dev en local / prod en el VPS
SPRING_PROFILES_ACTIVE=dev

POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora

# Firma los JWT propios (HS256). Mínimo 32 caracteres. GENERA UNO NUEVO EN
# PRODUCCIÓN, por ejemplo con: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789-0123456789-0123456789

# Orígenes desde los que el navegador puede llamar a esta API (separados
# por comas). nexora-web corre en :3006 en local; en el VPS agrega el
# dominio público real de nexora-web.
CORS_ALLOWED_ORIGINS=http://localhost:3006

# Resend (email transaccional — recuperación de contraseña, B10). Vacío en
# dev local = los códigos se loguean en vez de enviarse de verdad (ver
# ResendEmailSender). En el VPS SIEMPRE debe tener un valor real.
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@mail.franciscolopez.uk
MAIL_FROM_NAME=Nexora
